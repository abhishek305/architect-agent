# Document Architect - Environment Configuration
# Copy this file to .env and fill in your values
# 
# IMPORTANT: Never commit the .env file! It's in .gitignore.

# =============================================================================
# OPTION 1: OLLAMA CLOUD MODELS (Recommended - Free)
# =============================================================================
# Ollama Cloud lets you run massive models via Ollama's infrastructure.
# No API key required! Just sign in and pull a cloud model.
#
# Setup:
#   1. Install Ollama v0.12+: https://ollama.com
#   2. Sign in: ollama signin
#   3. Pull a cloud model: ollama pull qwen3-coder:480b-cloud
#
# Available cloud models:
#   - qwen3-coder:480b-cloud  (Best for code generation & TDRs)
#   - gpt-oss:120b-cloud      (General purpose)
#   - gpt-oss:20b-cloud       (Faster, smaller)
#   - deepseek-v3.1:671b-cloud (Largest, most capable)
#
# See: https://ollama.com/blog/cloud-models

USE_OLLAMA=true
OLLAMA_MODEL=qwen3-coder:480b-cloud
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=ollama

# =============================================================================
# OPTION 2: LOCAL OLLAMA (Free - requires GPU)
# =============================================================================
# Run models entirely on your machine.
# 
# Setup:
#   ollama pull llama3:8b      # 8GB VRAM
#   ollama pull codellama:7b   # 6GB VRAM
#   ollama pull llama3:70b     # 40GB VRAM
#
# USE_OLLAMA=true
# OLLAMA_MODEL=llama3:8b
# OLLAMA_BASE_URL=http://localhost:11434

# =============================================================================
# OPTION 3: GROQ (Free Tier - Very Fast!)
# =============================================================================
# Get your free API key from: https://console.groq.com/keys
# Set USE_OLLAMA=false to use Groq instead of Ollama.
#
# USE_OLLAMA=false
# GROQ_API_KEY=gsk_your_api_key_here

# =============================================================================
# OPTION 4: ANY MASTRA MODEL ROUTER PROVIDER (OpenAI, Anthropic, Gemini, ...)
# =============================================================================
# Set MODEL to "provider/model" plus that provider's API key. MODEL takes
# priority over the Ollama and Groq settings above. See https://mastra.ai/models
#
# MODEL=openai/gpt-5.1
# OPENAI_API_KEY=sk-your_api_key_here
#
# MODEL=anthropic/claude-sonnet-4-5
# ANTHROPIC_API_KEY=sk-ant-your_api_key_here
#
# MODEL=google/gemini-2.5-pro
# GOOGLE_GENERATIVE_AI_API_KEY=your_api_key_here

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================

# Log level (debug, info, warn, error)
LOG_LEVEL=info

# Enable/disable telemetry
TELEMETRY_ENABLED=false
